# ─────────────────────────────────────────────────────────────────────────
# DineFlow — environment variables
#
# Copy this file to `.env` (Prisma CLI reads `.env`) — you'll also want the
# same values in `.env.local` (Next.js reads that one at runtime). Keeping
# both in sync is annoying but standard; step-by-step values below.
#
# NEVER commit .env or .env.local — they're already in .gitignore.
# ─────────────────────────────────────────────────────────────────────────

# ── Database (Supabase → Project Settings → Database → Connection string) ──
# "Transaction" pooler connection (port 6543) — used by the running app.
DATABASE_URL="postgresql://postgres.xxxxx:[YOUR-PASSWORD]@aws-0-xxxxx.pooler.supabase.com:6543/postgres?pgbouncer=true"
# "Session"/direct connection (port 5432) — used only by Prisma CLI commands.
DIRECT_URL="postgresql://postgres.xxxxx:[YOUR-PASSWORD]@aws-0-xxxxx.pooler.supabase.com:5432/postgres"

# ── Supabase project (Project Settings → API) ──────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"   # server-only, never expose to the browser

# ── NextAuth ────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-generated-secret"
# Local dev: http://localhost:3000 — in production, your real domain.
NEXTAUTH_URL="http://localhost:3000"

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── SSLCommerz (Phase 4 — real payments) ────────────────────────────────────
# Get these from https://developer.sslcommerz.com (sandbox) — see
# docs/PHASE-4-PAYMENT-SETUP.md for step-by-step signup instructions.
SSLCOMMERZ_STORE_ID="dinef6a96c12641c31"
SSLCOMMERZ_STORE_PASSWORD="dinef6a96c12641c31@ssl"
# "false" while testing against the sandbox. Only set to "true" once you
# have real, approved LIVE credentials from SSLCommerz — sandbox and live
# credentials are different, and mixing them up sends real customers to a
# fake payment page (or fake test cards to a real one, which just fails).
SSLCOMMERZ_IS_LIVE="false"
